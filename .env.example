# Production (compose.yaml): domain Caddy obtains a certificate for.
LEXICONA_DOMAIN=lexicona.example.com
# Optional local development override for the separate read-only dictionary index:
# LEXICONA_DICTIONARY_PATH=data/dictionaries/eng-rus-2025.11.23.sqlite3
# Piper voices default to data/tts locally and /data/tts in the container.
# LEXICONA_TTS_DIR=/data/tts

# Optional external translation when the local dictionary has no match.
# Default: DeepL, with OpenRouter fallback on DeepL failure or missing DeepL key.
# Set LEXICONA_TRANSLATION_PROVIDER=openrouter to use OpenRouter directly.
# LEXICONA_TRANSLATION_PROVIDER=deepl
# LEXICONA_DEEPL_API_KEY=
# OpenRouter supplies examples, up to three translations and generated US IPA.
# LEXICONA_OPENROUTER_API_KEY=
# LEXICONA_OPENROUTER_MODEL=~deepseek/deepseek-flash-latest
