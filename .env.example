# Production (compose.yaml): domain Caddy obtains a certificate for.
LEXICONA_DOMAIN=lexicona.example.com
# Optional local development override for the separate read-only dictionary index:
# LEXICONA_DICTIONARY_PATH=data/dictionaries/eng-rus-2025.11.23.sqlite3

# Optional external translation when the local dictionary has no match.
# Default: DeepL, with Gemini fallback on DeepL failure or missing DeepL key.
# Set LEXICONA_TRANSLATION_PROVIDER=gemini to use Gemini directly.
# LEXICONA_TRANSLATION_PROVIDER=deepl
# LEXICONA_DEEPL_API_KEY=
# Gemini supplies up to three translations and generated US IPA on fallback.
# Free-tier content may be used by Google to improve products; do not submit private text.
# LEXICONA_TRANSLATION_PROVIDER=gemini
# LEXICONA_GEMINI_API_KEY=
# LEXICONA_GEMINI_MODEL=gemini-flash-lite-latest
