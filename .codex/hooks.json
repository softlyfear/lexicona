{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^apply_patch$|^Edit$|^Write$|^MultiEdit$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/format.py\"",
            "timeout": 30,
            "statusMessage": "Форматирование изменённых файлов"
          }
        ]
      }
    ]
  }
}
